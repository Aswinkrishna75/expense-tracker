@model Expense

<div asp-validation-summary="ModelOnly" class="error"></div>
<input type="hidden" asp-for="Id" />

<label>Title
    <input asp-for="Title" autofocus />
    <span asp-validation-for="Title" class="error"></span>
</label>

<label>Amount (₹)
    <input asp-for="Amount" type="number" step="0.01" min="0" />
    <span asp-validation-for="Amount" class="error"></span>
</label>

<label>Category
    <select asp-for="Category" asp-items="@(new SelectList(Expense.Categories))"></select>
</label>

<label>Date
    <input asp-for="Date" type="date" />
    <span asp-validation-for="Date" class="error"></span>
</label>

<label>Note (optional)
    <input asp-for="Note" />
    <span asp-validation-for="Note" class="error"></span>
</label>
