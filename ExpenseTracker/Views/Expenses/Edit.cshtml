@model Expense
@{ ViewData["Title"] = "Edit expense"; }

<h1>Edit expense</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form">
    <partial name="_Form" model="Model" />
    <div class="row">
        <button type="submit" class="btn">Save changes</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>
