<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Expense Tracker</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="top">
        <a class="brand" asp-controller="Expenses" asp-action="Index">Expense Tracker</a>
        <a class="btn" asp-controller="Expenses" asp-action="Create">Add expense</a>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
